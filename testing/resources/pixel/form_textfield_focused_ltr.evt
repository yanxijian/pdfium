# This test explicitly tests the interactive UI rendering (CPWL_EditImpl).
# We MUST leave the text field focused at the end of the test. Do not click outside of it.
# If the field loses focus, it will fall back to generating a static Appearance Stream.
# Click into the text field to focus it
mousemove,100,50
mousedown,left,100,50
mouseup,left,100,50
# Type Word 1 (a, b, c)
charcode,97
charcode,98
charcode,99
# Type ...
charcode,46
charcode,46
charcode,46
# Type Space
charcode,32
# Type Word 2 (d, e, f)
charcode,100
charcode,101
charcode,102
